# Copie para .env e preencha. O .env está no .gitignore e nunca deve ser commitado.

# Supabase → botão Connect → Connection string → Transaction pooler (porta 6543)
DATABASE_URL=postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres

# Fuso da academia. Todo o cálculo de datas usa o horário local do processo:
# sem isto, um servidor em UTC conta o treino das 22h como sendo do dia seguinte.
TZ=America/Sao_Paulo
