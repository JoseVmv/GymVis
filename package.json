{
  "name": "gymvis",
  "private": true,
  "version": "0.1.0",
  "description": "Camada de análise e inteligência sobre os dados de academias",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed -w server --",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "build": "npm run typecheck && npm run build -w client",
    "start": "npm run start -w server",
    "migrate": "node scripts/migrate.mjs",
    "importar:sqlite": "node scripts/importar-sqlite.mjs",
    "baseline": "node scripts/baseline.mjs capture verificacao/atual",
    "baseline:diff": "node scripts/baseline.mjs diff verificacao/sqlite verificacao/atual --ordenado",
    "verificar:dados": "node scripts/verificar-dados.mjs",
    "verificar:agregacoes": "node scripts/verificar-agregacoes.mjs",
    "verificar:isolamento": "node scripts/testar-isolamento.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
